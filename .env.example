# Base URL of the Growprize backend.
#
# Development (Recommended): gunakan Vite proxy "/api" agar browser memperlakukan
# session cookie HttpOnly sebagai same-origin pada localhost.
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=https://nexus.gtpscache.site

# Production: set directly to your production backend origin, e.g.:
# VITE_API_BASE_URL=https://nexus.gtpscache.site
